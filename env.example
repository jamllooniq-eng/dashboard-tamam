# ==============================================================================
# متغيرات بيئة متجر تمام شوب (TAMAM SHOP)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الموقع والخادم (Server & App URLs)
# ------------------------------------------------------------------------------
# APP_URL: رابط الموقع الأساسي المنشور (يُستخدم للـ SSR، Canonical URLs، OpenGraph، و sitemap.xml)
# الحالة: مطلوب في بيئة الإنتاج (يوجد Fallback تلقائي 'https://tamam-iq.com' في بيئة التطوير)
APP_URL="https://your-domain.com"

# NODE_ENV: بيئة تشغيل الخادم ('development' أو 'production')
# الحالة: اختياري (يُضبط تلقائياً بواسطة سكريبتات npm start / npm run dev)
NODE_ENV="development"

# ROLEMALL_API_TOKEN: توكن المورد Rolemall (يُقرأ من السيرفر فقط ولا يُكتب داخل الكود)
# الحالة: مطلوب (بدونه لن تظهر المنتجات)
ROLEMALL_API_TOKEN=""

# CHECKOUT_SECRET: سر داخلي لتوقيع الاتصال بين دالة الطلب ودالة الخلفية
# الحالة: اختياري (إذا لم يُحدد، يُشتق تلقائياً من GOOGLE_SHEET_WEBHOOK_URL / TELEGRAM_BOT_TOKEN)
CHECKOUT_SECRET=""

# ------------------------------------------------------------------------------
# قاعدة البيانات ولوحة التحكم (Supabase + /admin)
# ------------------------------------------------------------------------------
# SUPABASE_URL: رابط مشروع Supabase (Project Settings > API > Project URL)
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: المفتاح السري (secret / service_role). ضعه في Netlify فقط ولا تشاركه مع أحد
SUPABASE_SERVICE_ROLE_KEY=""

# ADMIN_PASSWORD: كلمة سر لوحة التحكم /admin (10 أحرف على الأقل). تغييرها يسجّل خروج كل الأجهزة
ADMIN_PASSWORD=""

# GOOGLE_SHEET_WEBHOOK_URL_MANUAL: رابط سكربت الشيت الآخر (طلبات المنتجات اليدوية)
GOOGLE_SHEET_WEBHOOK_URL_MANUAL=""

# ------------------------------------------------------------------------------
# 2. تتبع فيسبوك / ميتا (Meta Pixel & Conversions API - CAPI)
# ------------------------------------------------------------------------------
# META_PIXEL_ID: معرّف بيكسل فيسبوك/ميتا لتتبع الزوار وتفاعلات الشراء (ViewContent, Purchase)
# الحالة: اختياري (إذا لم يتوفر، يتم تعطيل التتبع في الفرونت إند والسيرفر بأمان دون التأثير على عمل الموقع)
META_PIXEL_ID=""

# META_ACCESS_TOKEN: رمز الوصول الخاص بـ Meta Conversions API لإرسال أحداث الشراء السيرفرية
# الحالة: اختياري (إذا لم يتوفر، يتم تخطي إرسال CAPI في السيرفر وتعتمد عملية الشراء على الـ Client Pixel فقط)
META_ACCESS_TOKEN=""

# META_TEST_EVENT_CODE: كود الاختبار الخاص بـ Meta Test Events (يُستخدم للتجربة المباشرة في مدير أحداث ميتا)
# الحالة: اختياري (فارغ في بيئة الإنتاج)
META_TEST_EVENT_CODE=""

# IQD_TO_USD_RATE: سعر صرف الدينار العراقي مقابل الدولار لتحويل قيمة الطلبات في تقارير Meta
# الحالة: اختياري (القيمة الافتراضية 1400 دينار لكل 1 دولار إذا لم يُحدد)
IQD_TO_USD_RATE="1400"

# META_GRAPH_VERSION: إصدار Graph API المستخدم لـ CAPI (غيّره فقط إذا أوقفت ميتا هذا الإصدار)
# الحالة: اختياري (الافتراضي v23.0)
META_GRAPH_VERSION=""

# ------------------------------------------------------------------------------
# 3. إشعارات وتكاملات الطلبات الجديدة (Order Notification Webhooks)
# ------------------------------------------------------------------------------
# GOOGLE_SHEET_WEBHOOK_URL: رابط Webhook الخاص بـ Google Apps Script لتسجيل الطلبات تلقائياً بجدول Google Sheets
# الحالة: اختياري (إذا لم يتوفر، يتم تسجيل الطلب بنجاح في Rolemall وتخطي إرسال بيانات الشيت بأمان)
GOOGLE_SHEET_WEBHOOK_URL=""

# TELEGRAM_BOT_TOKEN: توكن بوت تيليغرام المخصص لإرسال تنبيه فوري عند كل طلب شراء جديد
# الحالة: اختياري (إذا لم يتوفر أو لم يتوفر CHAT_ID، يتم تخطي إرسال رسالة التلغرام دون التأثير على اكتمال الطلب)
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: معرّف القناة أو المجموعة أو الحساب لاستقبال إشعارات الطلبات
# الحالة: اختياري (يُشترط توفره مع TELEGRAM_BOT_TOKEN لإرسال رسائل التنبيه)
TELEGRAM_CHAT_ID=""
